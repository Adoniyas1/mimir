{
  "name": "mimir",
  "version": "0.1.0",
  "description": "A desktop AI assistant with an animated face, a wake word, and the ability to rewrite its own source.",
  "private": true,
  "type": "module",
  "main": "electron-entry.mjs",
  "scripts": {
    "dev:renderer": "node scripts/prepare-vad-assets.mjs && vite",
    "build:renderer": "node scripts/prepare-vad-assets.mjs && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json && node scripts/write-preload-package-json.mjs",
    "build:supervisor": "tsc -p tsconfig.supervisor.json",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload && npm run build:supervisor",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.supervisor.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "start": "npm run build && npm run electron",
    "supervisor": "npm run build && tsx supervisor/index.ts",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@huggingface/transformers": "^3.2.1",
    "@ricky0123/vad-web": "^0.0.30",
    "katex": "^0.18.3",
    "keytar": "^7.9.0",
    "mermaid": "^11.16.1",
    "simple-git": "^3.27.0"
  },
  "optionalDependencies": {
    "@picovoice/porcupine-node": "^3.0.3",
    "@picovoice/pvrecorder-node": "^1.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.mimir.assistant",
    "productName": "Mimir",
    "directories": {
      "output": "dist-installers"
    },
    "files": [
      "dist/**/*",
      "electron-entry.mjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
